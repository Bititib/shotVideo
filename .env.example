# === 服务器配置 ===
PORT=3000
NODE_ENV=production

# === JWT 配置 ===
# 生产环境必须使用强随机密钥！可用 openssl rand -base64 48 生成
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# === Gemini API ===
# 单 Key
GEMINI_API_KEY=your-gemini-api-key
# 多 Key（逗号分隔，推荐：N个Key=N倍吞吐）
# GEMINI_API_KEYS=key1,key2,key3

# === HM Studio 渠道 ===
# 部署后会自动创建渠道；配置 Key 后自动启用，并可在渠道管理中同步模型
HM_STUDIO_API_KEY=
HM_STUDIO_CONCURRENCY=10
HM_STUDIO_USER_CONCURRENCY=2
HM_STUDIO_MAX_USER_QUEUE=10
HM_STUDIO_MAX_QUEUE=200

# === wx-海底月 sd2.5 分流渠道 ===
# 仅在 HM Studio 并发池满载且请求兼容时使用。留空则自动创建但保持禁用。
WX_HAIDIYUE_API_KEY=
# 海底月只接受图片 URL。建议使用直连本服务器、关闭 CDN 代理的独立 HTTPS 媒体域名。
# 该域名必须把 /uploads/* 转发到当前应用，示例：https://media-origin.example.com
WX_HAIDIYUE_IMAGE_BASE_URL=

# === NewToken channel ===
# Leave blank to keep the placeholder disabled. An empty value never replaces
# a channel key that was saved in the admin UI.
NEWTOKEN_BASE_URL=https://newtoken.club
NEWTOKEN_API_KEY=

# Maximum time to poll an asynchronous upstream video task (default: 30 min).
VIDEO_TASK_POLL_TIMEOUT_MS=1800000
# Signed /v1/videos/{task_id}/content URL lifetime (default: 24 hours).
VIDEO_CONTENT_URL_TTL_SECONDS=86400

# === 默认管理员 (首次启动自动创建) ===
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-strong-password


# === CORS 允许来源（生产环境必填，逗号分隔） ===
# 不填则允许所有来源（开发模式）
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# === 后端公网地址（Sora V3 Pro 参考图自托管需要） ===
# Docker 部署时必须填写，否则生成的素材 URL 可能不可达
# BACKEND_URL=https://yourdomain.com
